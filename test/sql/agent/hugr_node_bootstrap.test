<REGEX>:.*first_policy names no client - the console's is how the administrator gets in.*

statement error
SELECT * FROM hugr_node_bootstrap_plan(fp_doc(replace(fp_ok(), '"client_id": "0000-console"', '"client_id": ""')),
  environment := orchestrated_env());
----
<REGEX>:.*first_policy names a client without its client_id.*

statement error
SELECT * FROM hugr_node_bootstrap_plan(fp_doc(replace(fp_ok(), '"administrators": "hugr-admins", ', '')),
  environment := orchestrated_env());
----
<REGEX>:.*first_policy names no administrators.*

# a name goes into a management statement as an identifier: a plain one only
foreach name x.y x''y x\"y a/b

statement error
SELECT * FROM hugr_node_bootstrap_plan(fp_doc(replace(fp_ok(), '"name": "console"', '"name": "{name}"')),
  environment := orchestrated_env());
----
<REGEX>:.*first_policy names a client .* that is not a plain name.*

endloop

statement error
SELECT * FROM hugr_node_bootstrap_plan(fp_doc(replace(fp_ok(), '"name": "corp"', '"name": "corp corp"')),
  environment := orchestrated_env());
----
<REGEX>:.*first_policy names an issuer "corp corp" that is not a plain name.*

# two clients for one application would accept the same tokens; names compare exactly, as the policy compares them
statement error
