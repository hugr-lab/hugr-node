<REGEX>:.*first_policy has an issuer audience that is not a non-empty string.*

statement error
SELECT * FROM hugr_node_bootstrap_plan(fp_doc(replace(fp_ok(), '"roles_claim": "roles"', '"roles_claim": ""')),
  environment := orchestrated_env());
----
<REGEX>:.*first_policy names no issuer roles_claim.*

statement error
SELECT * FROM hugr_node_bootstrap_plan(fp_doc('{"issuer": {"name": "corp", "url": "https://x", "audiences": ["a"],
  "roles_claim": "roles"}, "clients": [], "administrators": "a", "resource_groups": [{"name": "etl"}]}'),
  environment := orchestrated_env());
