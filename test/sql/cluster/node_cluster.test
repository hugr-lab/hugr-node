# name: test/sql/cluster/node_cluster.test
# description: spec 118.2 - a cluster node's profile is what the fleet runs and platform.drift shows what this node
#   carries against it - ACL NATIVE stays unrestricted, its effect is shown, never refused. hugr-node spec 002: a
#   hugr_node node is a cluster node by construction (no acl_deployment: no single-node mode to switch to)
# group: [sql]

require hugr_node

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';

statement ok
ATTACH ':memory:' AS store;

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN CREATE ROLE root;

statement ok
ACL ADMIN GRANT ADMIN passthrough TO ROLE root;

statement ok
ACL ADMIN CREATE ROLE fleet;

statement ok
ACL ADMIN GRANT ADMIN cluster TO ROLE fleet;

statement ok
ACL ADMIN CREATE ROLE keeper;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE keeper WITH (select, secrets) MAIN;

# --- the node is a cluster node, whatever the number of nodes: nothing to set ----------------------------

statement error
SET GLOBAL acl_deployment = 'standalone';
----
<REGEX>:.*unrecognized configuration parameter "acl_deployment".*

# reading the (empty) profile
query I
SELECT acl_cluster_version();
----
0

# spec 125: the node says what it is, and offers the holder of the cluster bundle all of it - the profile's
# writes and drift
query TTTI
ACL ROLE "fleet" SELECT deployment, scopes, list_contains(my_views, 'drift'),
    len(list_filter(my_functions, lambda f: f LIKE 'cluster_%'))
FROM platform.console_info();
----
cluster	[observe, operate, cluster, policy, manage, passthrough]	true	4

# secrets only in the secrets service: without one, refused
statement error
ACL ROLE "keeper" CREATE SECRET s (TYPE http, BEARER_TOKEN 'v');
----
<REGEX>:.*no secrets service is attached to this node.*

# the profile: a source, a setting, an extension it names
statement ok
ACL ROLE "fleet" CLUSTER ATTACH ':memory:' AS src (TYPE duckdb);

statement ok
ACL ROLE "fleet" CLUSTER SET threads = 3;

statement ok
ACL ADMIN CLUSTER SET threads = 3;

# ACL NATIVE is the break-glass: a one-off ATTACH works - and drift shows it
statement ok
ACL ROLE "root" ACL NATIVE ATTACH ':memory:' AS oneoff;

statement ok
ACL ROLE "root" ACL NATIVE SET GLOBAL threads = 5;

query TTTTT
ACL ROLE "fleet" SELECT kind, name, state, node_value, profile_value FROM platform.drift WHERE kind <> 'extension' AND state <> 'bootstrap' ORDER BY kind, name;
----
database	oneoff	node_only	:memory:	NULL
database	src	same	:memory:	:memory:
setting	threads	differs	5	3

# bootstrap: the deployment's own, listed so nothing is silently hidden
query TT
ACL ROLE "fleet" SELECT name, state FROM platform.drift WHERE state = 'bootstrap' AND kind IN ('database', 'setting') ORDER BY name;
----
acl_node_group	bootstrap
memory	bootstrap
store	bootstrap

# a value is compared as duckdb shows it (review 118.2: '4GB' reads back as GiB), a source by its type
# (a relative file path shows absolute)
statement ok
ACL ADMIN CLUSTER SET memory_limit = '4GB';

statement ok
SET GLOBAL memory_limit = '4GB';

statement ok
ACL ADMIN CLUSTER ATTACH '__TEST_DIR__/drift_file.db' AS filesrc (TYPE duckdb);

query TT
ACL ROLE "fleet" SELECT name, state FROM platform.drift WHERE name IN ('memory_limit', 'filesrc') ORDER BY name;
----
filesrc	same
memory_limit	same

# the profile names what the node lacks: profile_only
statement ok
ACL ROLE "root" ACL NATIVE DETACH src;

query TT
ACL ROLE "fleet" SELECT name, state FROM platform.drift WHERE kind = 'database' AND name = 'src';
----
src	profile_only

# showing only: nothing was reverted
query I
SELECT count(*) FROM duckdb_databases() WHERE database_name = 'oneoff';
----
1

# who reads it: the cluster bundle and passthrough - not policy, not operate
statement ok
ACL ADMIN CREATE ROLE pol;

statement ok
ACL ADMIN GRANT ADMIN policy TO ROLE pol;

statement ok
ACL ADMIN CREATE ROLE ops;

statement ok
ACL ADMIN GRANT ADMIN operate TO ROLE ops;

statement error
ACL ROLE "pol" SELECT * FROM platform.drift;
----
<REGEX>:.*no access to object "platform.drift".*

statement error
ACL ROLE "ops" SELECT * FROM platform.drift;
----
<REGEX>:.*no access to object "platform.drift".*

query I
ACL ROLE "root" SELECT count(*) > 0 FROM platform.drift;
----
true

statement ok
SET GLOBAL threads = 3;
